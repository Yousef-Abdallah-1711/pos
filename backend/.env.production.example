# =============================================================
# POS SaaS Backend - Production Environment Variables
# =============================================================
# Copy this file and fill in actual values for your production deployment.
# NEVER commit actual secrets to version control.
# Use a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# =============================================================

# Server Configuration
PORT=8080
ENV=production
API_VERSION=v1

# Database (use managed PostgreSQL service in production)
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/pos_saas?sslmode=require
DB_HOST=your-db-host.region.rds.amazonaws.com
DB_PORT=5432
DB_USER=pos_api
DB_PASSWORD=CHANGE_ME_USE_SECRETS_MANAGER
DB_NAME=pos_saas
DB_SSLMODE=require
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis (use managed Redis service in production)
REDIS_URL=redis://your-redis-host:6379
REDIS_HOST=your-redis-host.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# JWT (generate a strong random secret: openssl rand -base64 64)
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=168h

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=https://www.yourdomain.com,https://dashboard.yourdomain.com,https://admin.yourdomain.com,https://accept.paymob.com

# Application URLs (REQUIRED for production)
APP_BASE_URL=https://api.yourdomain.com
DASHBOARD_URL=https://dashboard.yourdomain.com
LANDING_URL=https://www.yourdomain.com
RESTAURANT_DOMAIN=yourdomain.com
UPLOAD_BASE_URL=https://api.yourdomain.com/uploads
WEBHOOK_BASE_URL=https://api.yourdomain.com

# Paymob Payment Integration
PAYMOB_MODE=live
PAYMOB_API_KEY=CHANGE_ME
PAYMOB_INTEGRATION_ID=CHANGE_ME
PAYMOB_IFRAME_ID=CHANGE_ME
PAYMOB_HMAC_SECRET=CHANGE_ME
PAYMOB_BASE_URL=https://accept.paymob.com/api
SUBSCRIPTION_MONTHLY_PRICE_CENTS=50000
SUBSCRIPTION_ANNUAL_PRICE_CENTS=500000
SUBSCRIPTION_CURRENCY=EGP

# Email (SendGrid)
SENDGRID_API_KEY=CHANGE_ME
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Restaurant POS

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=info
