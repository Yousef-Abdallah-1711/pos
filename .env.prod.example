# Non-secret production settings and secret placeholders. Store the real file outside
# the repository at /etc/rakmyat-pos/production.env (root:root, mode 0600).

IMAGE_REGISTRY=ghcr.io/yousef-abdallah-1711/pos
IMAGE_TAG=sha-REPLACE_WITH_40_HEX_COMMIT

PUBLIC_API_URL=https://api.pos.rakmyat.online
LANDING_URL=https://pos.rakmyat.online
DASHBOARD_URL=https://pos.app.rakmyat.online
SUPER_ADMIN_URL=https://admin.pos.rakmyat.online
RESTAURANT_DOMAIN=restaurants.pos.rakmyat.online
CORS_ORIGINS=https://pos.rakmyat.online,https://pos.app.rakmyat.online,https://admin.pos.rakmyat.online,https://*.restaurants.pos.rakmyat.online

DB_NAME=pos_saas
DB_BOOTSTRAP_USER=pos_bootstrap
DB_BOOTSTRAP_PASSWORD=GENERATE_A_UNIQUE_SECRET
DB_USER=pos_app
DB_PASSWORD=GENERATE_A_UNIQUE_SECRET
MIGRATE_DB_USER=pos_migrator
MIGRATE_DB_PASSWORD=GENERATE_A_UNIQUE_SECRET
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_TIME=2m
DB_CONN_MAX_LIFETIME=5m

REDIS_PASSWORD=GENERATE_A_UNIQUE_SECRET
REDIS_PASSWORD_FILE=/etc/rakmyat-pos/redis-password
JWT_SECRET=GENERATE_A_UNIQUE_SECRET
JWT_EXPIRY=24h
RBAC_ENFORCEMENT=enforce
LOG_LEVEL=info

# Public payments remain fail-closed until real owner-controlled credentials exist.
PAYMOB_MODE=live
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com/api

# Loopback-only CloudPanel upstream ports; verify with ss before activation.
LANDING_HOST_PORT=13401
DASHBOARD_HOST_PORT=13402
RESTAURANT_HOST_PORT=13403
SUPER_ADMIN_HOST_PORT=13404
API_HOST_PORT=13405

# Release gates; keep false until the acceptance report and protected GitHub
# production Environment approve activation.
PRODUCTION_DEPLOYMENT_ENABLED=false
PRODUCTION_READINESS_APPROVED=false
MIGRATIONS_BACKWARD_COMPATIBLE=false
