# Copy to .env.prod (git-ignored) and fill in real values.
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Public URLs (no trailing slash). Baked into frontend builds.
PUBLIC_API_URL=https://api.yourdomain.com
LANDING_URL=https://www.yourdomain.com
DASHBOARD_URL=https://dashboard.yourdomain.com
RESTAURANT_DOMAIN=yourdomain.com
CORS_ORIGINS=https://www.yourdomain.com,https://dashboard.yourdomain.com,https://admin.yourdomain.com,https://accept.paymob.com

# Database
# Must stay "postgres": migration 050 grants to that role.
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=pos_saas
DB_SSLMODE=disable

# Auth: openssl rand -base64 64
JWT_SECRET=CHANGE_ME
JWT_EXPIRY=24h
LOG_LEVEL=info

# Paymob (REQUIRED in production: the API refuses to start in mock mode)
PAYMOB_MODE=live
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_BASE_URL=https://accept.paymob.com/api

# Host ports (put a TLS reverse proxy in front)
BACKEND_PORT=8080
LANDING_PORT=3001
DASHBOARD_PORT=3002
RESTAURANT_PORT=3003
SUPER_ADMIN_PORT=3004
