# Production image for any Next.js app in the pnpm workspace.
# Build from the frontend/ directory:
#   docker build -f Dockerfile.prod --build-arg APP=dashboard --build-arg NEXT_PUBLIC_API_URL=... -t pos-dashboard .
ARG NODE_IMAGE=node:20.20.2-alpine3.23@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

FROM ${NODE_IMAGE} AS base
RUN apk add --no-cache libc6-compat \
 && corepack enable \
 && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

FROM base AS deps
COPY . .
RUN pnpm install --frozen-lockfile

FROM base AS builder
ARG APP
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.
ARG NEXT_IGNORE_BUILD_ERRORS=false
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_SUPER_ADMIN_API_URL
ARG NEXT_PUBLIC_LANDING_URL
ARG NEXT_PUBLIC_DASHBOARD_URL
ARG NEXT_PUBLIC_RESTAURANT_DOMAIN
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_DEBUG_LOGS=false
ARG NEXT_PUBLIC_DEBUG=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_SUPER_ADMIN_API_URL=$NEXT_PUBLIC_SUPER_ADMIN_API_URL \
    NEXT_PUBLIC_LANDING_URL=$NEXT_PUBLIC_LANDING_URL \
    NEXT_PUBLIC_DASHBOARD_URL=$NEXT_PUBLIC_DASHBOARD_URL \
    NEXT_PUBLIC_RESTAURANT_DOMAIN=$NEXT_PUBLIC_RESTAURANT_DOMAIN \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_DEBUG_LOGS=$NEXT_PUBLIC_DEBUG_LOGS \
    NEXT_PUBLIC_DEBUG=$NEXT_PUBLIC_DEBUG \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
COPY --from=deps /app ./
RUN mkdir -p "apps/${APP}/public"
RUN pnpm --filter "./apps/${APP}" build

FROM ${NODE_IMAGE} AS runner
ARG APP
ARG PORT=3000
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=${PORT} \
    APP=${APP}
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
# Standalone output is rooted at the workspace root (outputFileTracingRoot), so the app lives at apps/<APP>.
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP}/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP}/public ./apps/${APP}/public
USER nextjs
EXPOSE ${PORT}
CMD ["sh", "-c", "node apps/${APP}/server.js"]
