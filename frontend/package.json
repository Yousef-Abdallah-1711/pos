      "baseline-browser-mapping": "2.11.37",
      "source-map-js": "1.2.2",
      "dompurify": "3.4.17",
      "@babel/core@^7": "7.29.6",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "minimatch@10": "10.2.4",
      "minimatch@11": "11.0.1",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
