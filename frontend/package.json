{
  "name": "pos-saas-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-preflight.js",
    "dev": "turbo run dev --parallel",
    "dev:dashboard": "pnpm --filter @pos-saas/dashboard dev",
    "dev:restaurant": "pnpm --filter @pos-saas/restaurant-website dev",
    "dev:landing": "pnpm --filter @pos-saas/landing dev",
    "dev:super-admin": "pnpm --filter @pos-saas/super-admin dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.3 <25",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
