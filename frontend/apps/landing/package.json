    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "^26.1.0",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "5.1.0"
