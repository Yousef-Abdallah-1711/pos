# Restaurant Website App - Local Development Environment Variables
# Local dev defaults only. Production/staging should use .env.production.example.
#
# Preferred variable:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_RESTAURANT_DOMAIN=localhost:3003
#
# Legacy alias still supported by runtime resolver (optional):
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Optional: API timeout in milliseconds (default: 5000)
# NEXT_PUBLIC_API_TIMEOUT=5000

# Optional: Enable debug logging (remove in production)
# NEXT_PUBLIC_DEBUG=false
