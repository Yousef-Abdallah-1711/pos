+			}
+			if report.EquationDifference != tt.wantEquationDelta || report.IntegrityCheckBasis != "existing_round2_equation_check" {
+				t.Fatalf("integrity diagnostics = %v/%q", report.EquationDifference, report.IntegrityCheckBasis)
+			}
