+name: pos-dev
+
+# DEVELOPMENT stack: Postgres + Go API + all four Next.js apps with hot reload.
+#   docker compose up --build
+# For the production stack see docker-compose.prod.yml.
+#
+# The frontend containers share the backend container's network namespace, so
+# "localhost:8080" inside a frontend container (SSR requests) reaches the API,
+# exactly like it does in the browser. That is why the app ports are published
+# on the backend service.
+
+x-frontend: &frontend
+  build:
+    context: ./frontend
+    dockerfile: Dockerfile.dev
+  working_dir: /app
+  network_mode: "service:backend"
+  depends_on:
+    frontend-install:
+      condition: service_completed_successfully
+    backend:
+      condition: service_started
+  volumes: &frontend-volumes
+    - ./frontend:/app
+    - pnpm_store:/pnpm-store
+    - node_modules_root:/app/node_modules
+    - node_modules_dashboard:/app/apps/dashboard/node_modules
+    - node_modules_landing:/app/apps/landing/node_modules
+    - node_modules_restaurant:/app/apps/restaurant-website/node_modules
+    - node_modules_super_admin:/app/apps/super-admin/node_modules
+    - node_modules_pkg_theme:/app/packages/theme/node_modules
+    - node_modules_pkg_ui:/app/packages/ui/node_modules
+    - node_modules_pkg_ui_components:/app/packages/ui-components/node_modules
+    - node_modules_layer_shared:/app/layers/shared-components/node_modules
+    - node_modules_layer_themes:/app/layers/ui-themes/node_modules
+    - next_dashboard:/app/apps/dashboard/.next
+    - next_landing:/app/apps/landing/.next
+    - next_restaurant:/app/apps/restaurant-website/.next
+    - next_super_admin:/app/apps/super-admin/.next
+  environment: &frontend-env
+    NODE_ENV: development
+    NEXT_PUBLIC_API_URL: http://localhost:8080/api/v1
+    NEXT_PUBLIC_API_BASE_URL: http://localhost:8080/api/v1
+    NEXT_PUBLIC_SUPER_ADMIN_API_URL: http://localhost:8080/api/v1/super-admin
+    NEXT_PUBLIC_LANDING_URL: http://localhost:3001
+    NEXT_PUBLIC_DASHBOARD_URL: http://localhost:3002
+    NEXT_PUBLIC_RESTAURANT_DOMAIN: localhost:3003
+  restart: unless-stopped
+
