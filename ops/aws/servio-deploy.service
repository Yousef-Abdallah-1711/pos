[Unit]
Description=Verify and pull accepted SERVIO staging releases (outbound only)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/etc/servio/staging-agent.accepted

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/servio
ExecStart=/usr/local/sbin/servio-pull-agent
TimeoutStartSec=25min
TimeoutStopSec=180
KillMode=mixed
Restart=no
UMask=0077
NoNewPrivileges=yes
# Preserve only the identity transition needed to drop acceptance tests to ubuntu.
# runuser clears these capabilities in the unprivileged child; NNP remains enabled.
AmbientCapabilities=CAP_SETUID CAP_SETGID
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/servio /var/lib/servio-deployer /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=512M
MemoryMax=768M
StandardOutput=append:/var/log/servio-deploy/agent.log
StandardError=append:/var/log/servio-deploy/agent.log
SyslogIdentifier=servio-deploy
